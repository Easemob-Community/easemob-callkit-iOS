{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"项目依赖环信 IM SDK 4.26.0 和声网 RTC SDK 4.6.2，最低系统为 iOS 15.0。CocoaPods 的 EaseCallUIKit 使用国内默认组合，Overseas 使用双框架，OverseasCallKit 使用纯 Apple CallKit。"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift 6.1 及以上可启用 LiveCommunicationKit 和 AppleCallKit Traits。默认 Trait 为 LiveCommunicationKit，纯 Apple CallKit 只启用 AppleCallKit。旧工具链使用兼容清单的默认组合。"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"宿主初始化 ChatClient，再在主线程调用 CallKitManager.shared.setup(config)。登录成功后设置 currentUserInfo，绑定普通 APNs token。默认通知点击转交 CallNotificationHandler，App 前后台事件转交 IM SDK。"}],"type":"paragraph"},{"code":["import EaseCallUIKit","","let config = CallKitConfig()","config.enableVOIP = true","CallKitManager.shared.setup(config)","","\/\/ IM 已登录并连接后，按需发起语音呼叫。","CallKitManager.shared.call(with: \"target-user-id\", type: .singleAudio)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Example 使用 CocoaPods，在 Example 目录安装依赖后打开 workspace。首页支持编辑账号、自动登录、退出登录、输入目标用户或群 ID、查看通话状态和日志。完整步骤见仓库内的文档。 "},{"type":"reference","identifier":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#运行-example","isActive":true},{"type":"text","text":" · "},{"type":"reference","identifier":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#在-app-中集成","isActive":true}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/easecalluikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"EaseCallUIKit"}],"role":"article","title":"接入与 Example","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"使用指南","identifiers":["doc:\/\/org.cocoapods.EaseCallUIKit\/documentation\/EaseCallUIKit\/IncomingCalls"],"generated":true,"title":"使用指南"}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.EaseCallUIKit\/documentation\/EaseCallUIKit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/org.cocoapods.EaseCallUIKit\/documentation\/EaseCallUIKit\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"从当前项目选择 CocoaPods subspec 或 SwiftPM Traits，初始化 IM 后启用通话。"}],"references":{"doc://org.cocoapods.EaseCallUIKit/documentation/EaseCallUIKit":{"type":"topic","url":"\/documentation\/easecalluikit","kind":"symbol","title":"EaseCallUIKit","identifier":"doc:\/\/org.cocoapods.EaseCallUIKit\/documentation\/EaseCallUIKit","abstract":[{"type":"text","text":"基于环信 IM 与声网 RTC 的 iOS 单聊、群聊音视频通话组件。"}],"role":"collection"},"doc://org.cocoapods.EaseCallUIKit/documentation/EaseCallUIKit/IncomingCalls":{"kind":"article","title":"来电呈现与推送","role":"collectionGroup","abstract":[{"text":"普通 APNs 与 VoIP Push 共用 IM 邀请和通话状态。","type":"text"}],"identifier":"doc:\/\/org.cocoapods.EaseCallUIKit\/documentation\/EaseCallUIKit\/IncomingCalls","type":"topic","url":"\/documentation\/easecalluikit\/incomingcalls"},"https://github.com/Easemob-Community/easemob-callkit-iOS#在-app-中集成":{"titleInlineContent":[{"type":"text","text":"集成指南"}],"type":"link","identifier":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#在-app-中集成","url":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#在-app-中集成","title":"集成指南"},"https://github.com/Easemob-Community/easemob-callkit-iOS#运行-example":{"titleInlineContent":[{"type":"text","text":"Example"}],"type":"link","identifier":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#运行-example","url":"https:\/\/github.com\/Easemob-Community\/easemob-callkit-iOS#运行-example","title":"Example"}}}